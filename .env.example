# Copy to .env and replace every change-me value before starting the stack.
POSTGRES_DB=project_monitoring
POSTGRES_USER=analytics
POSTGRES_PASSWORD=change-me

API_PORT=8080

# Must be at least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me
JWT_ISSUER=project-monitoring
JWT_AUDIENCE=project-monitoring-clients
JWT_EXPIRES_MINUTES=60

# Used only when this account does not exist yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

BACKUP_RETENTION_DAYS=7
