# Optional. `docker compose up` works without a .env file: non-secret settings have
# defaults, and secrets are generated once into the app_secrets volume.
#
# To override a value, copy this file to .env and uncomment the line. Secret and database
# values take effect on the first start only; use `docker compose down -v` to apply new
# ones, which also deletes all data and backups.

# POSTGRES_DB=project_monitoring
# POSTGRES_USER=analytics
# POSTGRES_PASSWORD=

# API_PORT=8080

# Must be at least 32 bytes. Generate one with: openssl rand -hex 48
# JWT_SECRET=
# JWT_ISSUER=project-monitoring
# JWT_AUDIENCE=project-monitoring-clients
# JWT_EXPIRES_MINUTES=60

# The account is created only if it does not exist yet.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# BACKUP_RETENTION_DAYS=7
# LOG_RETENTION_DAYS=30
