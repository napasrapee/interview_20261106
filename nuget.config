<?xml version="1.0" encoding="utf-8"?>
<!-- Makes restore independent of machine-level feeds, so anyone can build this repo. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
